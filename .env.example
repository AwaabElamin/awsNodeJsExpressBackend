PORT=3000
MONGODB_URI_USERS=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/users?retryWrites=true&w=majority
MONGODB_URI_DELIVERY=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/Delivery?retryWrites=true&w=majority
MONGODB_URI_RESUME=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/resume?retryWrites=true&w=majority
MONGODB_URI_CARSHOP=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/CarShop?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=14400
